#!/bin/sh
# Sourced by git-pr-* commands. Do not execute directly.
#
# Config file format (.pr-config):
#   PR_DEV_BRANCH=dev
#   PR_PRE_RELEASE_BRANCH=pre-release
#   PR_MAIN_BRANCH=main
#   PR_REVIEWERS=username1,username2
#
# Resolution order (later overrides earlier):
#   1. Built-in defaults
#   2. ~/.pr-config  (global)
#   3. <repo-root>/.pr-config  (per-repo)

# Built-in defaults
PR_DEV_BRANCH="dev"
PR_PRE_RELEASE_BRANCH="pre-release"
PR_MAIN_BRANCH="main"
PR_REVIEWERS=""

# Load global config
if [ -f "$HOME/.pr-config" ]; then
  . "$HOME/.pr-config"
fi

# Load repo-local config (overrides global)
_repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$_repo_root" ] && [ -f "$_repo_root/.pr-config" ]; then
  . "$_repo_root/.pr-config"
fi

# Returns 0 if the pre-release branch exists on origin, 1 otherwise
pre_release_exists() {
  git ls-remote --heads origin "$PR_PRE_RELEASE_BRANCH" 2>/dev/null | grep -q .
}
