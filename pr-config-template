# .pr-config
# Copy this file to ~/.pr-config (global defaults) and/or <repo-root>/.pr-config (per-repo overrides).
# Per-repo values take precedence over global. Only specify what differs from the defaults.
#
# Default values (used if not set):
#   PR_DEV_BRANCH=dev
#   PR_PRE_RELEASE_BRANCH=pre-release
#   PR_MAIN_BRANCH=main
#   PR_REVIEWERS=

# Comma-separated GitHub usernames to request review from on all PRs.
PR_REVIEWERS=username1,username2

# Branch names (override if your repo uses different conventions).
PR_DEV_BRANCH=dev
PR_PRE_RELEASE_BRANCH=pre-release
PR_MAIN_BRANCH=main

# For repos that work directly off main (no dev branch), set:
#   PR_DEV_BRANCH=main
# This makes `git pr` target main, and disables `git pr-release` / `git pr-pre-release`.
